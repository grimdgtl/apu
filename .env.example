# ============================================================
#  APU — Lični Telegram AI asistent
#  Kopiraj u `.env` i popuni vrednosti:  cp .env.example .env
# ============================================================

# --- Telegram ---------------------------------------------------------------
# Token dobijaš od @BotFather na Telegramu.
TELEGRAM_BOT_TOKEN=

# Tvoj lični Telegram chat ID (broj). Bot koristi ovo za proaktivne podsetnike
# i kao "whitelist" — odgovara samo tebi. Saznaj svoj ID preko @userinfobot.
TELEGRAM_OWNER_CHAT_ID=

# --- Anthropic / Claude -----------------------------------------------------
ANTHROPIC_API_KEY=

# Model. Claude 3.5 Sonnet je povučen sa API-ja — koristimo Claude Sonnet 5.
# Za maksimalnu pamet stavi claude-opus-4-8 (skuplje). Kod je isti.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Notion -----------------------------------------------------------------
# Internal integration token: https://www.notion.so/my-integrations
# Ne zaboravi da "share"-uješ obe baze sa integracijom.
NOTION_API_KEY=

# ID baze zadataka (TASK BOARD) i stranice Knowledge Base.
# Obe MORAŠ da podeliš sa integracijom u Notion-u (⋯ → Connections → dodaj).
NOTION_TASKS_DB_ID=
NOTION_KB_PAGE_ID=

# ID baze "Dnevna checklista" (Life stranica).
NOTION_CHECKLIST_DB_ID=

# Nov red u checklisti svako jutro u 5:00; podsetnik da je popuniš u 21:30.
CHECKLIST_CREATE_CRON=0 5 * * *
CHECKLIST_REMINDER_CRON=30 21 * * *
# ID baze "Dnevnik" i "To-do lista" (obe na Life stranici).
NOTION_DNEVNIK_DB_ID=
NOTION_TODO_DB_ID=

# Čestitka u 23:00 ako je dan popunjen preko ovog procenta.
CHECKLIST_PRAISE_CRON=0 23 * * *
CHECKLIST_PRAISE_THRESHOLD=70
# Nedeljna pohvala — nedeljom u 22:00.
WEEKLY_SUMMARY_CRON=0 22 * * 0
# Nedeljni zadatak "cveće za Sofiju" — ponedeljkom u 5:00.
FLOWERS_TASK_CRON=0 5 * * 1
# --- Semanticka pretraga (embeddings) ---------------------------------------
# Koristi OPENAI_API_KEY (isti kao za glasovne). Indeks se osvezava svaki dan u 4:00.
SEMANTIC_INDEX_CRON=0 4 * * *

# ID baze KLIJENTI — izvor liste sajtova za monitoring (kolone: Klijent, Domen, Aktivan).
# Bot proverava samo redove sa statusom "Aktivan". Prazno = monitoring isključen.
NOTION_CLIENTS_DB_ID=

# ID baze Rođendani (Dashboard → Life → Rođendani). Kolone: Ime i prezime,
# Rođendan (datum), Odnos, Telefon, Ideja za poklon, Napomena.
# Prazno = podsetnici za rođendane isključeni.
NOTION_BIRTHDAYS_DB_ID=

# ID baze FAKTURE (Dashboard → Work → FIRMA → FAKTURE). Odavde se uzima
# sledeći redni broj i ovde se upisuje svaka izdata faktura.
# Prazno = izrada faktura isključena.
NOTION_INVOICES_DB_ID=

# --- Google Calendar --------------------------------------------------------
# OAuth 2.0 "Desktop app" kredencijali iz Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Refresh token — dobijaš ga jednom pokretanjem: npm run auth:google
GOOGLE_REFRESH_TOKEN=

# Koji kalendar koristiti (podrazumevano tvoj glavni).
GOOGLE_CALENDAR_ID=primary

# Vremenska zona za termine.
TIMEZONE=Europe/Belgrade

# --- Vremenska prognoza (Open-Meteo, besplatno, bez ključa) ------------------
# Koordinate lokacije za jutarnju prognozu. Podrazumevano Beograd.
WEATHER_LAT=45.2671
WEATHER_LON=19.8335
WEATHER_LOCATION=Novi Sad

# --- Mail (IMAP za čitanje, SMTP za slanje) ---------------------------------
# Za Gmail koristi App Password (ne običnu lozinku): https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Ime i adresa koji se prikazuju kao pošiljalac.
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# --- Resend (slanje preko HTTPS API-ja umesto SMTP-a) ---------------------
# Ako je Hetzner/provajder blokirao SMTP portove, koristi Resend: napravi nalog
# na resend.com, verifikuj domen grim-digital.com (DNS zapisi), pa nalepi ključ.
# Kad je popunjen, bot šalje preko Resend-a; prazno = koristi SMTP gore.
RESEND_API_KEY=

# --- Glasovne poruke (transkripcija) ----------------------------------------
# Za diktiranje botu glasom. Popuni JEDAN od dva ključa:
#   OPENAI_API_KEY (whisper-1) ili GROQ_API_KEY (whisper-large-v3, besplatan nivo).
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Trajno čuvanje ---------------------------------------------------------
# Gde se čuva istorija razgovora. Na serveru montiraj kao persistent volume,
# inače bot zaboravi kontekst pri svakom restartu/redeployu.
DATA_DIR=./data

# --- Proaktivni podsetnici (cron) -------------------------------------------
# Jutarnji pozdrav (motivacija + prognoza) — svaki dan u 6:00.
MORNING_GREETING_CRON=0 6 * * *
# Poslovni pregled (kalendar, zadaci, mejlovi) — svaki dan u 9:30.
MORNING_BRIEFING_CRON=30 9 * * *
# Podsetnik za porez — 14. u mesecu u 10:00.
TAX_REMINDER_CRON=0 10 14 * *

# --- Monitoring sajtova -----------------------------------------------------
# Tiha provera (javi SAMO ako nešto nije u redu) — svaki dan u 10:00.
SITE_CHECK_SILENT_CRON=0 10 * * *
# Pun izveštaj (uvek javi, i kad je sve OK) — svaki dan u 18:00.
SITE_CHECK_REPORT_CRON=0 18 * * *

# Provera nepročitanih mejlova — svaki pun sat od 8 do 22 (ne budi noću).
MAIL_CHECK_CRON=0 8-22 * * *
# Posle koliko ms bez odgovora se sajt smatra "pao" (default 15s).
SITE_MONITOR_TIMEOUT_MS=15000
# Preko koliko ms se učitavanje smatra "sporim" (default 5s).
SITE_MONITOR_SLOW_MS=5000

# --- Fakture ----------------------------------------------------------------
# Podaci izdavaoca — idu na SVAKU fakturu. Namerno u .env, a ne u chat, da ih
# model ne može promeniti (naročito broj računa na koji se uplaćuje).
INVOICE_ISSUER_NAME=Nikola Milić PR Labart
INVOICE_ISSUER_BRAND=LABART
INVOICE_ISSUER_ADDRESS=Ruže Šulman 17/1
INVOICE_ISSUER_CITY=Zrenjanin
INVOICE_ISSUER_PHONE=+381640313796
INVOICE_ISSUER_PIB=113343290
INVOICE_ISSUER_MB=66755657
INVOICE_ISSUER_ACCOUNT=265-1100310081259-33
INVOICE_ISSUER_BANK=Raiffeisenbank Srbija
INVOICE_RESPONSIBLE_PERSON=Nikola Milić

# Poslednja faktura izdata PRE ovog bota, u formatu NNN-GGGG. Arhiva ne sadrži
# starije fakture, pa bi numeracija inače krenula od 001 i ponovila već izdat
# broj. Prag važi SAMO za svoju godinu — sledeća godina sama kreće od 001, ne
# moraš ništa da menjaš.
INVOICE_LAST_NUMBER=059-2026

# Fiksni tekstovi u podnožju fakture.
INVOICE_COMMENT=Račun je važeći bez pečata i potpisa.
INVOICE_VAT_NOTE=Pravno lice nije u sistemu PDV-a.

# ID Drive foldera u koji se snimaju PDF-ovi (iz URL-a foldera).
# Prazno = snima u koren Drive-a.
GOOGLE_INVOICES_FOLDER_ID=

# --- Rođendani --------------------------------------------------------------
# Najava ko danas slavi — svaki dan u 11:00.
BIRTHDAY_MORNING_CRON=0 11 * * *
# Podsetnik ako još nisi čestitao — svaki dan u 19:00.
BIRTHDAY_EVENING_CRON=0 19 * * *
# --- Coolify / Nixpacks build ------------------------------------------------
# Aplikacija ovo NE cita — koristi ga Coolify pri buildu. Bez njega Nixpacks
# gradi sa Node 18 (EOL). Ostavi ga u env-u koji lepis u Coolify.
NIXPACKS_NODE_VERSION=22
