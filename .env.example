# ============================================================
#  APU — Lični Telegram AI asistent
#  Kopiraj u `.env` i popuni vrednosti:  cp .env.example .env
# ============================================================

# --- Telegram ---------------------------------------------------------------
# Token dobijaš od @BotFather na Telegramu.
TELEGRAM_BOT_TOKEN=

# Tvoj lični Telegram chat ID (broj). Bot koristi ovo za proaktivne podsetnike
# i kao "whitelist" — odgovara samo tebi. Saznaj svoj ID preko @userinfobot.
TELEGRAM_OWNER_CHAT_ID=

# --- Anthropic / Claude -----------------------------------------------------
ANTHROPIC_API_KEY=

# Model. Claude 3.5 Sonnet je povučen sa API-ja — koristimo Claude Sonnet 5.
# Za maksimalnu pamet stavi claude-opus-4-8 (skuplje). Kod je isti.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Notion -----------------------------------------------------------------
# Internal integration token: https://www.notion.so/my-integrations
# Ne zaboravi da "share"-uješ obe baze sa integracijom.
NOTION_API_KEY=

# ID baze zadataka (TASK BOARD) i stranice Knowledge Base.
# Obe MORAŠ da podeliš sa integracijom u Notion-u (⋯ → Connections → dodaj).
NOTION_TASKS_DB_ID=
NOTION_KB_PAGE_ID=

# --- Google Calendar --------------------------------------------------------
# OAuth 2.0 "Desktop app" kredencijali iz Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Refresh token — dobijaš ga jednom pokretanjem: npm run auth:google
GOOGLE_REFRESH_TOKEN=

# Koji kalendar koristiti (podrazumevano tvoj glavni).
GOOGLE_CALENDAR_ID=primary

# Vremenska zona za termine.
TIMEZONE=Europe/Belgrade

# --- Mail (IMAP za čitanje, SMTP za slanje) ---------------------------------
# Za Gmail koristi App Password (ne običnu lozinku): https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Ime i adresa koji se prikazuju kao pošiljalac.
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# --- Trajno čuvanje ---------------------------------------------------------
# Gde se čuva istorija razgovora. Na serveru montiraj kao persistent volume,
# inače bot zaboravi kontekst pri svakom restartu/redeployu.
DATA_DIR=./data

# --- Proaktivni podsetnici (cron) -------------------------------------------
# Jutarnji pregled — svaki dan u 10:00.
MORNING_BRIEFING_CRON=0 10 * * *
# Podsetnik za porez — 14. u mesecu u 10:00.
TAX_REMINDER_CRON=0 10 14 * *
